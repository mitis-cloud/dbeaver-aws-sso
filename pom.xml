<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cloud.mitis.dbeaver</groupId>
    <artifactId>dbeaver-aws-sso</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DBeaver AWS SSO</name>
    <url>https://github.com/mitis-cloud/dbeaver-aws-sso</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <tycho.version>5.0.4</tycho.version>
    </properties>
    <modules>
        <module>plugins/cloud.mitis.dbeaver.aws.sso</module>
        <module>features/cloud.mitis.dbeaver.aws.sso.feature</module>
        <module>repository</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <target>
                        <file>${maven.multiModuleProjectDirectory}/dbeaver.target</file>
                    </target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
